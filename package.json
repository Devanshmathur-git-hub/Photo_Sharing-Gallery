{
  "name": "photo-sharing-gallery",
  "version": "1.0.0",
  "private": true,
  "description": "Photo Sharing/Gallery - MERN stack app",
  "scripts": {
    "backend": "cd backend && node server.js",
    "frontend": "cd frontend && npm run dev",
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"npm run backend\" \"npm run frontend\"",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}


